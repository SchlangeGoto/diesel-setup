#!/usr/bin/env python3
"""Send desktop notifications for upcoming Google Calendar events.

Runs from a systemd user timer every five minutes. Uses the same cache as the
Caelestia Agenda tab, so it does not need a separate login or token.
"""

from __future__ import annotations

import datetime as dt
import json
import os
import subprocess
from pathlib import Path

HOME = Path.home()
FETCH = HOME / ".local/bin/agenda-calendar"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "caelestia" / "agenda-calendar.json"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "agenda-notify" / "notified.json"
WINDOW_SECONDS = 10 * 60
NOTIFY = "/usr/bin/notify-send"

# School events are intentionally excluded: only personal appointments and
# tests/deadlines are worth an interruption.
DEFAULT_CALENDARS = ("Privat", "Tests & Due Dates")


def notify_calendars() -> set[str]:
    raw = os.environ.get("AGENDA_NOTIFY_CALENDARS", "")
    names = [part.strip() for part in raw.split(",") if part.strip()] or DEFAULT_CALENDARS
    return {name.casefold() for name in names}


def load_notified() -> dict:
    try:
        return json.loads(STATE.read_text(encoding="utf-8"))
    except Exception:
        return {}


def save_notified(data: dict) -> None:
    try:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
        os.chmod(STATE, 0o600)
    except Exception:
        pass


def main() -> None:
    today = dt.datetime.now().astimezone().date().isoformat()
    subprocess.run(
        [str(FETCH), "--date", today],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=60,
        check=False,
    )

    try:
        data = json.loads(CACHE.read_text(encoding="utf-8"))
    except Exception:
        return

    now = dt.datetime.now().astimezone()
    notified = load_notified()
    changed = False
    allowed = notify_calendars()

    for event in data.get("events") or []:
        if (event.get("calendar") or "").strip().casefold() not in allowed:
            continue

        start_raw = event.get("start") or ""
        if "T" not in start_raw:
            continue

        try:
            start = dt.datetime.fromisoformat(start_raw)
            if start.tzinfo is None:
                start = start.replace(tzinfo=now.tzinfo)
        except Exception:
            continue

        seconds = (start - now).total_seconds()
        if seconds <= 0 or seconds > WINDOW_SECONDS:
            continue

        key = f"{start_raw}|{event.get('summary', '')}"
        if key in notified:
            continue

        minutes = max(1, round(seconds / 60))
        title = f"In {minutes} min: {event.get('summary') or 'Termin'}"
        details = []
        if event.get("time"):
            details.append(event["time"])
        if event.get("location"):
            details.append(event["location"])
        if event.get("calendar"):
            details.append(event["calendar"])
        body = " · ".join(details)

        if Path(NOTIFY).exists():
            subprocess.run(
                [NOTIFY, "-a", "Caelestia Agenda", "-i", "calendar", title, body],
                check=False,
            )

        notified[key] = now.timestamp()
        changed = True

    cutoff = now.timestamp() - 2 * 86400
    notified = {key: value for key, value in notified.items() if value >= cutoff}
    if changed or len(notified) != len(load_notified()):
        save_notified(notified)


if __name__ == "__main__":
    main()
