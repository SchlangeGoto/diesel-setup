{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "open-design": {
        "type": "local",
        "command": [
          "docker",
          "exec",
          "-i",
          "open-design",
          "node",
          "/app/apps/daemon/dist/cli.js",
          "mcp",
          "serve",
          "--daemon-url",
          "http://127.0.0.1:7456"
        ],
        "disabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium",
          "--executable-path",
          "/home/kraftstoff/.local/bin/chromium-mcp",
          "--headless"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath",
          "/home/kraftstoff/.local/bin/chromium-mcp",
          "--no-usage-statistics"
        ]
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/kraftstoff/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  },
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents/*", "effect": "allow" },
    { "action": "read", "resource": "~/.agents/*", "effect": "allow" },
    { "action": "edit", "resource": "~/.agents/*", "effect": "allow" },
    { "action": "read", "resource": "/tmp/*", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],
  "plugins": [
    "opencode-mem"
  ]
}
