From 4b811732cc4332b600c8eeebf1ee787e99d4336c Mon Sep 17 00:00:00 2001
From: SchlangeGoto <kazimir@kkazi.dev>
Date: Tue, 17 Nov 2026 07:58:35 +0100
Subject: [PATCH 7/7] Restore default dashboard loader while keeping agenda
 cache

---
 modules/bar/popouts/Content.qml |  3 ---
 modules/dashboard/Content.qml   | 11 +++++++----
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/modules/bar/popouts/Content.qml b/modules/bar/popouts/Content.qml
index ea58731..50d19f2 100644
--- a/modules/bar/popouts/Content.qml
+++ b/modules/bar/popouts/Content.qml
@@ -105,7 +105,6 @@ Item {
 
         Popout {
             name: "clock"
-            keepLoaded: true
             sourceComponent: ClockPopout {
                 popouts: root.popouts
                 screenState: root.screenState
@@ -176,7 +175,6 @@ Item {
         required property string name
         readonly property bool shouldBeActive: root.popouts.currentName === name
         property bool ready: true
-        property bool keepLoaded: false
 
         anchors.centerIn: parent
 
@@ -205,7 +203,6 @@ Item {
                     }
                     PropertyAction {
                         property: "active"
-                        value: popout.keepLoaded
                     }
                 }
             },
diff --git a/modules/dashboard/Content.qml b/modules/dashboard/Content.qml
index 48af1b4..48dec7f 100644
--- a/modules/dashboard/Content.qml
+++ b/modules/dashboard/Content.qml
@@ -148,10 +148,13 @@ Item {
 
                         sourceComponent: modelData.component
 
-                        // Load only the active tab. Keeping every tab loaded
-                        // made the first dashboard open noticeably slower.
-                        active: index === view.currentIndex
-                        asynchronous: index !== 0
+                        Component.onCompleted: active = Qt.binding(() => {
+                            if (index === view.currentIndex)
+                                return true;
+                            const vx = Math.floor(view.visibleArea.xPosition * view.contentWidth);
+                            const vex = Math.floor(vx + view.visibleArea.widthRatio * view.contentWidth);
+                            return (vx >= x && vx <= x + implicitWidth) || (vex >= x && vex <= x + implicitWidth);
+                        })
                     }
                 }
             }
-- 
