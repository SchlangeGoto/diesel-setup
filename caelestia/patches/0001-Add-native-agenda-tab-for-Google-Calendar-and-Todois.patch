diff --git a/services/Agenda.qml b/services/Agenda.qml
new file mode 100644
index 0000000..01a0d4e
--- /dev/null
+++ b/services/Agenda.qml
@@ -0,0 +1,431 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Caelestia
+import Caelestia.Config
+import Caelestia.I18n
+import qs.utils
+
+Singleton {
+    id: root
+
+    readonly property string configPath: `${Paths.config}/agenda.json`
+    readonly property var defaults: ({
+            calendar: {
+                enabled: true,
+                days: 7,
+                calendars: ["School", "Tests & Due Dates", "Privat"]
+            },
+            todoist: {
+                enabled: true,
+                days: 3
+            }
+        })
+
+    property var config: root.mergedConfig(root.defaults)
+    property bool configReady: false
+    property bool calendarEnabled: true
+    property bool todoistEnabled: true
+
+    property var calendarEvents: []
+    property var todoistTasks: []
+    property bool loadingCalendar: false
+    property bool loadingTodoist: false
+    property string calendarError: ""
+    property string todoistError: ""
+    property bool calendarStale: false
+    property bool todoistStale: false
+    property double calendarUpdated: 0
+    property double todoistUpdated: 0
+
+    property bool closingTask: false
+    property var closeQueue: []
+    property bool writingConfig: false
+
+    readonly property var calendarSections: root.buildSections(root.calendarEvents)
+    readonly property var todoistSections: root.buildTaskSections(root.todoistTasks)
+    readonly property bool anyEnabled: root.calendarEnabled || root.todoistEnabled
+    readonly property bool anyLoading: (root.calendarEnabled && root.loadingCalendar) || (root.todoistEnabled && root.loadingTodoist)
+    readonly property bool anyStale: (root.calendarEnabled && root.calendarStale) || (root.todoistEnabled && root.todoistStale)
+
+    function mergedConfig(raw: var): var {
+        const source = raw ?? {};
+        const calendar = source.calendar ?? {};
+        const todoist = source.todoist ?? {};
+        const calendars = Array.isArray(calendar.calendars) ? calendar.calendars : root.defaults.calendar.calendars;
+        const calendarDays = Number(calendar.days);
+        const todoistDays = Number(todoist.days);
+
+        return {
+            calendar: {
+                enabled: calendar.enabled !== false,
+                days: Number.isFinite(calendarDays) ? Math.max(1, Math.min(31, Math.trunc(calendarDays))) : 7,
+                calendars: calendars
+            },
+            todoist: {
+                enabled: todoist.enabled !== false,
+                days: Number.isFinite(todoistDays) ? Math.max(0, Math.min(14, Math.trunc(todoistDays))) : 3
+            }
+        };
+    }
+
+    function applyConfig(raw: string): void {
+        let parsed = {};
+        try {
+            parsed = raw.trim().length > 0 ? JSON.parse(raw) : root.defaults;
+        } catch (error) {
+            console.warn(lc, `Unable to parse agenda config: ${error}`);
+        }
+
+        root.config = root.mergedConfig(parsed);
+        root.calendarEnabled = root.config.calendar.enabled;
+        root.todoistEnabled = root.config.todoist.enabled;
+
+        if (!root.configReady) {
+            root.configReady = true;
+            Qt.callLater(() => root.refreshAll());
+        } else {
+            Qt.callLater(() => root.refreshAll());
+        }
+    }
+
+    function saveConfig(): void {
+        root.writingConfig = true;
+        configFile.setText(JSON.stringify(root.config, null, 4));
+        configWriteTimer.restart();
+    }
+
+    function setCalendarEnabled(enabled: bool): void {
+        root.config.calendar.enabled = enabled;
+        root.calendarEnabled = enabled;
+        root.saveConfig();
+        if (enabled)
+            root.refreshCalendar();
+    }
+
+    function setTodoistEnabled(enabled: bool): void {
+        root.config.todoist.enabled = enabled;
+        root.todoistEnabled = enabled;
+        root.saveConfig();
+        if (enabled)
+            root.refreshTodoist();
+    }
+
+    function refreshAll(): void {
+        if (root.calendarEnabled)
+            root.refreshCalendar();
+        if (root.todoistEnabled)
+            root.refreshTodoist();
+    }
+
+    function refreshCalendar(): void {
+        if (!root.calendarEnabled || calendarProc.running)
+            return;
+        root.loadingCalendar = true;
+        root.calendarError = "";
+        calendarProc.running = true;
+    }
+
+    function refreshTodoist(): void {
+        if (!root.todoistEnabled || todoistProc.running)
+            return;
+        root.loadingTodoist = true;
+        root.todoistError = "";
+        todoistProc.running = true;
+    }
+
+    function completeTask(id: string): void {
+        if (!id)
+            return;
+
+        if (root.closingTask) {
+            root.closeQueue.push(id);
+            return;
+        }
+
+        root.closingTask = true;
+        root.todoistTasks = root.todoistTasks.filter(task => task.id !== id);
+        closeProc.command = [`${Paths.home}/.local/bin/agenda-todoist-close`, id];
+        closeProc.running = true;
+    }
+
+    function runNextClose(): void {
+        if (root.closeQueue.length === 0) {
+            root.closingTask = false;
+            root.refreshTodoist();
+            return;
+        }
+
+        const id = root.closeQueue.shift();
+        root.todoistTasks = root.todoistTasks.filter(task => task.id !== id);
+        closeProc.command = [`${Paths.home}/.local/bin/agenda-todoist-close`, id];
+        closeProc.running = true;
+    }
+
+    function openEvent(event: var): void {
+        if (!event || !event.date) {
+            Quickshell.execDetached(["xdg-open", "https://calendar.google.com"]);
+            return;
+        }
+
+        const parts = event.date.split("-");
+        if (parts.length !== 3) {
+            Quickshell.execDetached(["xdg-open", "https://calendar.google.com"]);
+            return;
+        }
+
+        Quickshell.execDetached(["xdg-open", `https://calendar.google.com/calendar/u/0/r/day/${parts[0]}/${parseInt(parts[1])}/${parseInt(parts[2])}`]);
+    }
+
+    function openTask(task: var): void {
+        if (!task || !task.id)
+            return;
+        Quickshell.execDetached(["xdg-open", `https://todoist.com/app/task/${task.id}`]);
+    }
+
+    function buildSections(events: var): var {
+        const sections = [];
+        for (const event of events) {
+            const date = event.date ?? "";
+            let section = sections.find(item => item.date === date);
+            if (!section) {
+                section = {
+                    date: date,
+                    label: root.formatDay(date),
+                    events: []
+                };
+                sections.push(section);
+            }
+            section.events.push(event);
+        }
+        return sections;
+    }
+
+    function todayString(): string {
+        const today = new Date();
+        return `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
+    }
+
+    function buildTaskSections(tasks: var): var {
+        const groups = [
+            {
+                key: "overdue",
+                label: Tr.tr("Overdue"),
+                tasks: []
+            },
+            {
+                key: "today",
+                label: Tr.tr("Today"),
+                tasks: []
+            },
+            {
+                key: "upcoming",
+                label: Tr.tr("Upcoming"),
+                tasks: []
+            }
+        ];
+        const today = root.todayString();
+
+        for (const task of tasks) {
+            if (task.overdue)
+                groups[0].tasks.push(task);
+            else if (task.date === today)
+                groups[1].tasks.push(task);
+            else
+                groups[2].tasks.push(task);
+        }
+
+        return groups.filter(group => group.tasks.length > 0);
+    }
+
+    function formatDay(date: string): string {
+        if (!date)
+            return "";
+
+        const value = new Date(`${date}T00:00:00`);
+        if (isNaN(value.getTime()))
+            return date;
+
+        const today = new Date();
+        today.setHours(0, 0, 0, 0);
+
+        const diff = Math.round((value - today) / 86400000);
+        if (diff === 0)
+            return Tr.tr("Today");
+        if (diff === 1)
+            return Tr.tr("Tomorrow");
+
+        return value.toLocaleDateString(Qt.locale(), "ddd dd.MM.");
+    }
+
+    function taskDueLabel(task: var): string {
+        if (!task)
+            return "";
+        if (task.overdue)
+            return Tr.tr("Overdue");
+
+        if (task.date === root.todayString())
+            return task.time ? task.time : Tr.tr("Today");
+
+        const value = new Date(`${task.date}T00:00:00`);
+        if (isNaN(value.getTime()))
+            return task.date;
+
+        return value.toLocaleDateString(Qt.locale(), "ddd dd.MM.");
+    }
+
+    Timer {
+        interval: 5 * 60 * 1000
+        repeat: true
+        running: root.configReady && root.anyEnabled
+        triggeredOnStart: true
+        onTriggered: root.refreshAll()
+    }
+
+    Timer {
+        id: configWriteTimer
+
+        interval: 400
+        onTriggered: root.writingConfig = false
+    }
+
+    FileView {
+        id: configFile
+
+        path: root.configPath
+        watchChanges: true
+        atomicWrites: true
+        printErrors: false
+        onLoaded: root.applyConfig(text())
+        onFileChanged: {
+            if (!root.writingConfig)
+                reload();
+        }
+        onSaveFailed: error => console.warn(lc, `Unable to save agenda config: ${error}`)
+        onLoadFailed: error => {
+            if (error === FileViewError.FileNotFound) {
+                root.config = root.mergedConfig(root.defaults);
+                root.calendarEnabled = root.config.calendar.enabled;
+                root.todoistEnabled = root.config.todoist.enabled;
+                root.configReady = true;
+                Qt.callLater(() => {
+                    root.saveConfig();
+                    root.refreshAll();
+                });
+            } else {
+                console.warn(lc, `Unable to load agenda config: ${error}`);
+            }
+        }
+    }
+
+    Process {
+        id: calendarProc
+
+        command: [`${Paths.home}/.local/bin/agenda-calendar`]
+        running: false
+
+        onRunningChanged: {
+            if (running)
+                root.loadingCalendar = true;
+        }
+
+        onExited: exitCode => { // qmllint disable signal-handler-parameters
+            root.loadingCalendar = false;
+
+            if (exitCode !== 0) {
+                root.calendarError = calendarErr.text.trim() || Tr.tr("Could not fetch calendar");
+                return;
+            }
+
+            try {
+                const data = JSON.parse(calendarOut.text);
+                root.calendarEvents = data.events ?? [];
+                root.calendarStale = data.stale === true;
+                root.calendarError = data.error ?? "";
+                root.calendarUpdated = data.generated ? Date.parse(data.generated) : Date.now();
+            } catch (error) {
+                root.calendarError = Tr.tr("Could not parse calendar data");
+                console.warn(lc, `Unable to parse calendar data: ${error}`);
+            }
+        }
+
+        stdout: StdioCollector {
+            id: calendarOut
+        }
+
+        stderr: StdioCollector {
+            id: calendarErr
+        }
+    }
+
+    Process {
+        id: todoistProc
+
+        command: [`${Paths.home}/.local/bin/agenda-todoist`]
+        running: false
+
+        onRunningChanged: {
+            if (running)
+                root.loadingTodoist = true;
+        }
+
+        onExited: exitCode => { // qmllint disable signal-handler-parameters
+            root.loadingTodoist = false;
+
+            if (exitCode !== 0) {
+                root.todoistError = todoistErr.text.trim() || Tr.tr("Could not fetch Todoist tasks");
+                return;
+            }
+
+            try {
+                const data = JSON.parse(todoistOut.text);
+                root.todoistTasks = data.tasks ?? [];
+                root.todoistStale = data.stale === true;
+                root.todoistError = data.error ?? "";
+                root.todoistUpdated = data.generated ? Date.parse(data.generated) : Date.now();
+            } catch (error) {
+                root.todoistError = Tr.tr("Could not parse Todoist data");
+                console.warn(lc, `Unable to parse Todoist data: ${error}`);
+            }
+        }
+
+        stdout: StdioCollector {
+            id: todoistOut
+        }
+
+        stderr: StdioCollector {
+            id: todoistErr
+        }
+    }
+
+    Process {
+        id: closeProc
+
+        running: false
+
+        onExited: exitCode => { // qmllint disable signal-handler-parameters
+            if (exitCode !== 0) {
+                Toaster.error(Tr.tr("Todoist"), Tr.tr("Could not complete task"), "error");
+                root.refreshTodoist();
+                root.closingTask = false;
+                root.closeQueue = [];
+                return;
+            }
+
+            root.runNextClose();
+        }
+
+        stderr: StdioCollector {
+            id: closeErr
+        }
+    }
+
+    LoggingCategory {
+        id: lc
+
+        name: "caelestia.qml.services.agenda"
+        defaultLogLevel: LoggingCategory.Info
+    }
+}
