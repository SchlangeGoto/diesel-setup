diff --git a/modules/dashboard/AgendaTab.qml b/modules/dashboard/AgendaTab.qml
new file mode 100644
index 0000000..3a56563
--- /dev/null
+++ b/modules/dashboard/AgendaTab.qml
@@ -0,0 +1,573 @@
+import QtQuick
+import QtQuick.Layouts
+import Caelestia.Config
+import Caelestia.I18n
+import qs.components
+import qs.components.containers
+import qs.components.controls
+import qs.services
+import qs.utils
+
+Item {
+    id: root
+
+    implicitWidth: 854
+    implicitHeight: 570
+
+    function calendarColour(name: string): color {
+        const value = (name || "").trim().toLowerCase();
+        if (value.includes("test"))
+            return Colours.palette.m3tertiary;
+        if (value.includes("school"))
+            return Colours.palette.m3primary;
+        return Colours.palette.m3secondary;
+    }
+
+    function priorityColour(priority: int): color {
+        switch (priority) {
+        case 4:
+            return Colours.palette.m3error;
+        case 3:
+            return Colours.palette.m3tertiary;
+        case 2:
+            return Colours.palette.m3primary;
+        default:
+            return Colours.palette.m3outline;
+        }
+    }
+
+    function dueColour(task: var): color {
+        if (task.overdue)
+            return Colours.palette.m3error;
+        if (task.date === Agenda.todayString())
+            return Colours.palette.m3primary;
+        return Colours.palette.m3onSurfaceVariant;
+    }
+
+    function refreshLabel(): string {
+        if (!Agenda.anyEnabled)
+            return Tr.tr("Both sources are off");
+        if (Agenda.anyLoading)
+            return Tr.tr("Updating...");
+        if (Agenda.anyStale)
+            return Tr.tr("Showing cached data");
+
+        const stamps = [];
+        if (Agenda.calendarEnabled && Agenda.calendarUpdated > 0)
+            stamps.push(Agenda.calendarUpdated);
+        if (Agenda.todoistEnabled && Agenda.todoistUpdated > 0)
+            stamps.push(Agenda.todoistUpdated);
+        if (stamps.length === 0)
+            return Tr.tr("Not loaded yet");
+
+        return Tr.tr("Updated %1").arg(Qt.formatTime(new Date(Math.max(...stamps)), "HH:mm"));
+    }
+
+    ColumnLayout {
+        anchors.fill: parent
+        anchors.margins: Tokens.padding.large
+        spacing: Tokens.spacing.medium
+
+        RowLayout {
+            Layout.fillWidth: true
+            spacing: Tokens.spacing.medium
+
+            Column {
+                spacing: 0
+
+                StyledText {
+                    text: Tr.tr("Agenda")
+                    font: Tokens.font.title.builders.large.weight(Font.DemiBold).build()
+                    color: Colours.palette.m3onSurface
+                }
+
+                StyledText {
+                    text: root.refreshLabel()
+                    font: Tokens.font.body.small
+                    color: Colours.palette.m3onSurfaceVariant
+                }
+            }
+
+            Item {
+                Layout.fillWidth: true
+            }
+
+            IconTextButton {
+                icon: "calendar_month"
+                text: Tr.tr("Calendar")
+                type: IconTextButton.Tonal
+                isToggle: true
+                checked: Agenda.calendarEnabled
+                onClicked: Agenda.setCalendarEnabled(!Agenda.calendarEnabled)
+            }
+
+            IconTextButton {
+                icon: "checklist"
+                text: Tr.tr("Todoist")
+                type: IconTextButton.Tonal
+                isToggle: true
+                checked: Agenda.todoistEnabled
+                onClicked: Agenda.setTodoistEnabled(!Agenda.todoistEnabled)
+            }
+
+            IconButton {
+                icon: "refresh"
+                type: IconButton.Tonal
+                isRound: true
+                enabled: Agenda.anyEnabled
+                onClicked: Agenda.refreshAll()
+            }
+        }
+
+        Item {
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+
+            RowLayout {
+                anchors.fill: parent
+                spacing: Tokens.spacing.medium
+                visible: Agenda.anyEnabled
+
+                StyledRect {
+                    visible: Agenda.calendarEnabled
+                    Layout.fillWidth: true
+                    Layout.fillHeight: true
+                    Layout.preferredWidth: 1
+
+                    color: Colours.tPalette.m3surfaceContainer
+                    radius: Tokens.rounding.extraLarge
+
+                    ColumnLayout {
+                        anchors.fill: parent
+                        anchors.margins: Tokens.padding.large
+                        spacing: Tokens.spacing.small
