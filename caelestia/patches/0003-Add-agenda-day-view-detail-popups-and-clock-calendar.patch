+    function eventTimeLabel(event: var): string {
+        if (!event)
+            return "";
+
+        const day = Agenda.formatDay(event.date);
+        if (event.allDay)
+            return `${day} · ${Tr.tr("All day")}`;
+
+        let value = `${day} · ${event.time}`;
+        if (event.end && event.end.includes("T")) {
+            const end = new Date(event.end);
+            if (!isNaN(end.getTime()))
+                value += ` – ${Qt.formatTime(end, "HH:mm")}`;
+        }
+        return value;
+    }
+
+    function taskTimeLabel(task: var): string {
+        if (!task)
+            return "";
+
+        const day = Agenda.formatDay(task.date);
+        if (task.allDay || !task.time)
+            return day;
+        return `${day} · ${task.time}`;
+    }
+
