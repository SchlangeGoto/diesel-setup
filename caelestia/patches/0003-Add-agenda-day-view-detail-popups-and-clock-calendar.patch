diff --git a/modules/bar/popouts/MiniCalendar.qml b/modules/bar/popouts/MiniCalendar.qml
new file mode 100644
index 0000000..fddb4d0
--- /dev/null
+++ b/modules/bar/popouts/MiniCalendar.qml
@@ -0,0 +1,112 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+import Caelestia.Config
+import Caelestia.I18n
+import qs.components
+import qs.components.controls
+
+Item {
+    id: root
+
+    signal dateSelected(date selectedDate)
+
+    property date currentDate: new Date()
+
+    readonly property int currMonth: currentDate.getMonth()
+    readonly property int currYear: currentDate.getFullYear()
+
+    implicitWidth: 300
+    implicitHeight: layout.implicitHeight
+
+    ColumnLayout {
+        id: layout
+
+        anchors.fill: parent
+        spacing: Tokens.spacing.extraSmall
+
+        RowLayout {
+            Layout.fillWidth: true
+
+            IconButton {
+                icon: "chevron_left"
+                type: IconButton.Text
+                isRound: true
+                onClicked: root.currentDate = new Date(root.currYear, root.currMonth - 1, 1)
+            }
+
+            StyledText {
+                Layout.fillWidth: true
+                horizontalAlignment: Text.AlignHCenter
+                text: grid.title
+                color: Colours.palette.m3primary
+                font: Tokens.font.title.small
+            }
+
+            IconButton {
+                icon: "chevron_right"
+                type: IconButton.Text
+                isRound: true
+                onClicked: root.currentDate = new Date(root.currYear, root.currMonth + 1, 1)
+            }
+        }
+
+        DayOfWeekRow {
+            Layout.fillWidth: true
+            locale: grid.locale
+
+            delegate: StyledText {
+                required property var model
+
+                horizontalAlignment: Text.AlignHCenter
+                text: model.shortName
+                font: Tokens.font.body.small
+                color: model.day === 0 || model.day === 6 ? Colours.palette.m3tertiary : Colours.palette.m3onSurfaceVariant
+            }
+        }
+
+        MonthGrid {
+            id: grid
+
+            Layout.fillWidth: true
+            month: root.currMonth
+            year: root.currYear
+            locale: Qt.locale()
+            spacing: 3
+
+            delegate: Item {
+                id: day
+
+                required property var model
+
+                implicitWidth: implicitHeight
+                implicitHeight: Math.max(dayText.implicitHeight + Tokens.padding.small, 30)
+
+                Rectangle {
+                    anchors.fill: parent
+                    radius: width / 2
+                    color: day.model.today ? Colours.palette.m3primary : dayMouse.containsMouse ? Qt.alpha(Colours.palette.m3onSurface, 0.08) : "transparent"
+                }
+
+                StyledText {
+                    id: dayText
+
+                    anchors.centerIn: parent
+                    text: day.model.day
+                    color: day.model.today ? Colours.palette.m3onPrimary : Colours.palette.m3onSurfaceVariant
+                    opacity: day.model.month === grid.month || day.model.today ? 1 : 0.4
+                    font: Tokens.font.body.small
+                }
+
+                MouseArea {
+                    id: dayMouse
+
+                    anchors.fill: parent
+                    hoverEnabled: true
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: root.dateSelected(day.model.date)
+                }
+            }
+        }
+    }
+}
