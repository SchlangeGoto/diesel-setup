+    function setActive(value: bool): void {
+        root.active = value;
+        if (value && root.configReady) {
+            root.loadCaches();
+            root.refreshAll();
+        }
+    }
+
+    function loadCaches(): void {
+        try {
+            root.applyCalendarCache(calendarCache.text());
+        } catch (error) {
+            console.debug(lc, `No calendar cache: ${error}`);
+        }
+        try {
+            root.applyTodoistCache(todoistCache.text());
+        } catch (error) {
+            console.debug(lc, `No Todoist cache: ${error}`);
+        }
+    }
+
+    function applyCalendarCache(raw: string): void {
+        try {
+            const data = JSON.parse(raw);
+            const query = root.dayMode ? `date:${root.selectedDate}` : `days:${root.config.calendar.days}`;
+            if (data.query && data.query !== query)
+                return;
+            root.calendarEvents = data.events ?? [];
+            root.calendarStale = true;
+            root.calendarUpdated = data.generated ? Date.parse(data.generated) : 0;
+        } catch (error) {
+            console.debug(lc, `Unable to parse calendar cache: ${error}`);
+        }
+    }
+
+    function applyTodoistCache(raw: string): void {
+        try {
+            const data = JSON.parse(raw);
+            root.todoistAllTasks = data.tasks ?? [];
+            root.todoistStale = true;
+            root.todoistUpdated = data.generated ? Date.parse(data.generated) : 0;
+        } catch (error) {
+            console.debug(lc, `Unable to parse Todoist cache: ${error}`);
+        }
+    }
+
